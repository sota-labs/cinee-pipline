    "ioredis": "^5.10.1",
    "mongoose": "^9.3.1",
    "nestjs-telegraf": "^2.9.1",
    "node-cron": "^4.2.1",
    "openai": "^6.34.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "telegraf": "^4.16.3",
    "zod": "^4.3.6"
