{
  "apps": [
    {
      "name": "cinee-dev",
      "script": "node",
      "args": "./dist/index.js",
      "log_date_format": "YYYY-MM-DD hh:mm:ss",
      "watch": false,
      "autorestart": true,
      "max_restarts": 10,
      "restart_delay": 3000
    },
    {
      "name": "cinee-kol-daemon",
      "script": "node",
      "args": "./dist/scripts/kolDaemon.js",
      "log_date_format": "YYYY-MM-DD hh:mm:ss",
      "watch": false,
      "autorestart": true,
      "max_restarts": 10,
      "restart_delay": 3000
    },
    {
      "name": "cinee-reject-expired-replies",
      "script": "node",
      "args": "./dist/scripts/kolAutoRejectCron.js",
      "log_date_format": "YYYY-MM-DD hh:mm:ss",
      "watch": false,
      "autorestart": true,
      "max_restarts": 10,
      "restart_delay": 3000
    }
  ]
}