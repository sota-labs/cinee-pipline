# ── Data Stores ──
REDIS_URL=redis://localhost:6379/0
MONGO_URI=mongodb://localhost:27017/cinee_pipeline

# ── Role ──
FOUNDER_NAME=Founder

# ── Role Config Override (optional) ──
# Point to a JSON file that overrides any fields in RoleConfig.
# Useful for switching to a different topic domain without code changes.
# The JSON must match the RoleConfig interface (all fields optional).
# Example: ROLE_CONFIG_PATH=/home/user/configs/crypto-role.json
# ROLE_CONFIG_PATH=

# ── Server ──
PORT=3000
NODE_ENV=development

# ── Public API URL (used in OpenClaw prompts) ──
PUBLIC_API_URL=http://localhost:3000

# ── OpenClaw ──
OPENCLAW_AGENT=main
OPENCLAW_CRAWL_MODEL=openrouter/minimax/minimax-m2.5
# Model used for personality learning (learn slang) and reply suggestion generation.
# Use a stronger model here for better quality output.
OPENCLAW_ANALYSIS_MODEL=openrouter/anthropic/claude-sonnet-4.6
X_USERNAME=<your_x_handle_without_@>

# ── Telegram Bot (KOL engagement) ──
KOL_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_ADMIN_CHAT_ID=<your_telegram_chat_id>